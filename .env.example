# Copy to .env.local for local development.
# In production these live in the Cloudflare dashboard — see DEPLOYMENT.md.

# ── Build-time ──────────────────────────────────────────────────────────────
# Next inlines NEXT_PUBLIC_* into the bundle during `next build`, and this app
# prerenders pages from Supabase at build time, so these must be present when
# the build runs — not just at runtime. On Cloudflare they go in
# Settings → Build → Variables.
#
# Safe to expose: the storefront only reads, and row-level security limits the
# publishable key to the public catalogue. No secret key is used here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Runtime secret ──────────────────────────────────────────────────────────
# Shared with the admin, which presents it when asking this app to rebuild a
# page. Must match the admin's REVALIDATE_SECRET exactly.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=generate-a-long-random-string
